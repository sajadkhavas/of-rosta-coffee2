{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "wrangler dev --config .output/server/wrangler.json",
    "routes:generate": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "bun test tests/unit",
    "test:unit:watch": "bun test --watch tests/unit",
    "test:browser": "playwright test",
    "audit:phase6": "node scripts/audit-phase6-security.mjs",
    "audit:seo": "node scripts/audit-seo-content.mjs",
    "audit:phase16": "node scripts/audit-phase16-performance.mjs",
    "audit:phase17": "node scripts/audit-phase17-release-baseline.mjs",
    "audit:admin-finance": "node scripts/audit-admin-finance.mjs",
    "audit:seller-operations": "node scripts/audit-seller-operations.mjs",
    "audit:admin-operations": "node scripts/audit-admin-operations.mjs",
    "audit:phase20": "node scripts/audit-phase20-completion.mjs",
    "audit:phase21": "node scripts/audit-phase21-live-public.mjs",
    "audit:phase22": "node scripts/audit-phase22-staging.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs .output release-manifest.json",
    "release:verify": "bun run check && bun run release:manifest",
    "check": "bun run audit:phase6 && bun run audit:seo && bun run audit:phase16 && bun run audit:phase17 && bun run audit:admin-finance && bun run audit:seller-operations && bun run audit:admin-operations && bun run audit:phase20 && bun run audit:phase21 && bun run audit:phase22 && bun run test:unit && bun run typecheck && bun run lint && bun run build && bun run bundle:check",
    "check:backend": "cd backend && composer check",
    "check:all": "bun run check && bun run check:backend",
    "backend:setup": "bash backend/scripts/setup.sh",
    "backend:up": "cd backend && docker compose up -d mysql redis api worker scheduler",
    "backend:down": "cd backend && docker compose down",
    "backend:logs": "cd backend && docker compose logs -f api worker scheduler",
    "backend:check": "cd backend && docker compose run --rm api composer check",
    "staging:deploy": "bash deploy/staging/deploy.sh",
    "staging:accept": "bash deploy/staging/acceptance.sh",
    "staging:backup": "bash deploy/staging/backup.sh",
    "staging:rollback": "bash deploy/staging/rollback.sh",
    "staging:restore": "bash deploy/staging/restore-backup.sh"
  },

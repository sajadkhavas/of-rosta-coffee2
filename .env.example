# Public frontend origin used for canonical URLs and Open Graph metadata.
VITE_SITE_URL=https://rosta.shop

# Laravel API base URL. Production must use the real HTTPS API origin.
VITE_API_URL=http://localhost:8000/api/v1

# Exact payment redirect hosts, separated by commas. Do not include a scheme or path.
# The configured site and API hosts are included automatically. Add the approved gateway hosts only.
VITE_PAYMENT_REDIRECT_HOSTS=

# Keep false for local, preview and staging. Enable only on the verified production deployment.
VITE_ALLOW_INDEXING=false

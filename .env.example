# Public frontend origin used for canonical URLs and Open Graph metadata.
VITE_SITE_URL=https://rosta.shop

# Laravel API base URL. Production should use the real HTTPS API origin.
VITE_API_URL=http://localhost:8000/api/v1

# Keep false for local, preview and staging. Enable only on the verified production deployment.
VITE_ALLOW_INDEXING=false

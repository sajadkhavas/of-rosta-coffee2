APP_NAME=Rosta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rosta
DB_USERNAME=rosta
DB_PASSWORD=rosta_local_only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@rosta.local
MAIL_FROM_NAME=Rosta

ROSTA_API_VERSION=v1
ROSTA_CONTRACT_VERSION=2026-07-21-phase-6
ROSTA_PAYMENT_ENABLED=false
ROSTA_SMS_ENABLED=false
ROSTA_ALLOWED_PAYMENT_REDIRECT_HOSTS=localhost,127.0.0.1
ROSTA_ALLOWED_MEDIA_HOSTS=
ROSTA_OTP_TTL_SECONDS=120
ROSTA_OTP_RESEND_AFTER_SECONDS=60
ROSTA_OTP_MAX_ATTEMPTS=5
ROSTA_AUTH_SESSION_TTL_MINUTES=120
ROSTA_MAX_ACTIVE_SESSIONS=5
ROSTA_MAX_ADDRESSES_PER_USER=20
ROSTA_MAX_PRODUCTS_PER_ROASTERY=1000
ROSTA_MAX_MEDIA_PER_ROASTERY=10000
ROSTA_QUOTE_TTL_MINUTES=15
ROSTA_RESERVATION_TTL_MINUTES=20
ROSTA_ORDER_IDEMPOTENCY_TTL_HOURS=24

# Local/testing only until provider credentials and callback domains are verified.
SMS_DRIVER=log
SMS_API_KEY=
PAYMENT_DRIVER=disabled
PAYMENT_MERCHANT_ID=

{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "rosta/backend",
  "type": "project",
  "description": "Security-first Laravel API for the Rosta whole-bean coffee marketplace.",
  "keywords": ["laravel", "rosta", "marketplace", "coffee"],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.8",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan storage:link --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "audit:business": "@php scripts/audit-business-contract.php",
    "audit:checkout": "@php scripts/audit-checkout-contract.php",
    "audit:seo": "@php scripts/audit-seo-content-contract.php",
    "audit:cooci-adoption": "@php scripts/audit-cooci-adoption.php",
    "audit:fulfillment": "@php scripts/audit-fulfillment-contract.php",
    "audit:reviews-support": "@php scripts/audit-reviews-support-contract.php",
    "audit:media-storage": "@php scripts/audit-media-storage-contract.php",
    "audit:openapi": "@php scripts/audit-commerce-openapi-drift.php",
    "audit:validation": "@php scripts/audit-validation-hardening.php",
    "audit:finance": "@php scripts/audit-finance-contract.php",
    "audit:seller-operations": "@php scripts/audit-seller-operations-contract.php",
    "audit:admin-operations": "@php scripts/audit-admin-operations-contract.php",
    "audit:live-public": "@php scripts/audit-live-public-contract.php",
    "audit:staging": "@php scripts/audit-staging-deployment-contract.php",
    "audit:encrypted-storage": "@php scripts/audit-encrypted-storage-contract.php",
    "readiness": "@php artisan rosta:readiness --json",
    "acceptance:infrastructure": "@php artisan rosta:infrastructure-acceptance --json",
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@php artisan test"
    ],
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint --parallel",
    "check": [
      "@composer validate --strict",
      "@composer audit --locked",
      "@audit:business",
      "@audit:checkout",
      "@audit:seo",
      "@audit:cooci-adoption",
      "@audit:fulfillment",
      "@audit:reviews-support",
      "@audit:media-storage",
      "@audit:openapi",
      "@audit:validation",
      "@audit:finance",
      "@audit:seller-operations",
      "@audit:admin-operations",
      "@audit:live-public",
      "@audit:staging",
      "@audit:encrypted-storage",
      "@php artisan test",
      "@php vendor/bin/phpstan analyse --memory-limit=1G",
      "@php vendor/bin/pint --parallel --test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

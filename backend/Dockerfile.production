# syntax=docker/dockerfile:1.7

FROM composer:2 AS vendor
WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --no-scripts \
    --classmap-authoritative

COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction \
    && (php artisan storage:link --relative || true)

FROM php:8.3-fpm-bookworm AS app

ENV APP_ENV=production \
    APP_DEBUG=false \
    COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libicu-dev \
        libonig-dev \
        libxml2-dev \
        libzip-dev \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        dom \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_mysql \
        posix \
        simplexml \
        sockets \
        xml \
        xmlwriter \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

WORKDIR /var/www/html
COPY --from=vendor --chown=www-data:www-data /app /var/www/html
COPY docker/php-production.ini /usr/local/etc/php/conf.d/99-rosta-production.ini
COPY docker/entrypoint.sh /usr/local/bin/rosta-entrypoint

RUN chmod +x /usr/local/bin/rosta-entrypoint \
    && mkdir -p \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data
EXPOSE 9000
ENTRYPOINT ["rosta-entrypoint"]
CMD ["php-fpm", "-F"]

FROM nginx:1.27-alpine AS web
WORKDIR /var/www/html
COPY --from=vendor /app/public /var/www/html/public
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080

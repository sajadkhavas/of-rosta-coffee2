# Non-secret release identity for ROSTA server fast path.
# Copy to /etc/rosta/staging/server-entry.env only after the prebuilt-image
# workflow has produced a matching manifest.

ROSTA_RELEASE_SHA=4a54780d504b91527a86777e7f04368022354686
ROSTA_RELEASE_TAG=rosta-pre-server-2026-09-05
ROSTA_CONFIG_ID=CHANGE_ME_FROM_IMAGE_WORKFLOW

# Replace CONFIG_ID with the exact workflow output.
ROSTA_API_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-api:4a54780d504b91527a86777e7f04368022354686
ROSTA_API_WEB_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-api-web:4a54780d504b91527a86777e7f04368022354686
ROSTA_FRONTEND_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-frontend:4a54780d504b91527a86777e7f04368022354686-CHANGE_ME_FROM_IMAGE_WORKFLOW

ROSTA_ROOT_DIR=/srv/rosta
ROSTA_FRONTEND_ENV_PATH=/etc/rosta/staging/frontend.env
ROSTA_BACKEND_ENV_PATH=/etc/rosta/staging/backend.env
ROSTA_STATE_DIR=/var/lib/rosta/staging

# Leave blank for public GHCR packages.
# For private packages inject these into the shell/session or a root-owned
# credential file; never commit a real token.
GHCR_USERNAME=
GHCR_TOKEN=

# Non-secret release identity template for the ROSTA server fast path.
# Populate only after Local/VSCode acceptance and creation of an immutable
# rosta-server-ready-* tag for the exact accepted commit.

ROSTA_RELEASE_SHA=CHANGE_ME_EXACT_40_CHAR_SHA
ROSTA_RELEASE_TAG=rosta-server-ready-YYYY-MM-DD
ROSTA_CONFIG_ID=CHANGE_ME_FROM_IMAGE_WORKFLOW

ROSTA_API_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-api:CHANGE_ME_EXACT_40_CHAR_SHA
ROSTA_API_WEB_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-api-web:CHANGE_ME_EXACT_40_CHAR_SHA
ROSTA_FRONTEND_REMOTE_IMAGE=ghcr.io/sajadkhavas/rosta-frontend:CHANGE_ME_EXACT_40_CHAR_SHA-CHANGE_ME_FROM_IMAGE_WORKFLOW

ROSTA_ROOT_DIR=/srv/rosta
ROSTA_FRONTEND_ENV_PATH=/etc/rosta/staging/frontend.env
ROSTA_BACKEND_ENV_PATH=/etc/rosta/staging/backend.env
ROSTA_STATE_DIR=/var/lib/rosta/staging

# Leave blank for public GHCR packages.
# For private packages inject these into the shell/session or a root-owned
# credential file; never commit a real token.
GHCR_USERNAME=
GHCR_TOKEN=

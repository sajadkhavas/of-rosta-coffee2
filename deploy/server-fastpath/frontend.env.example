# Staging/public runtime identity. No production traffic is permitted here.
# Replace staging.rosta.shop only after the staging hostname is chosen.

STAGING_SITE_DOMAIN=staging.rosta.shop
STAGING_API_DOMAIN=api.staging.rosta.shop
STAGING_MEDIA_DOMAIN=media.staging.rosta.shop

VITE_SITE_URL=https://staging.rosta.shop
VITE_API_URL=https://api.staging.rosta.shop/api/v1
VITE_PAYMENT_REDIRECT_HOSTS=staging.rosta.shop
VITE_ALLOW_INDEXING=false
VITE_PERFORMANCE_ENDPOINT=

ACME_EMAIL=CHANGE_ME

# Compose/runtime identity.
COMPOSE_PROJECT_NAME=rosta-staging

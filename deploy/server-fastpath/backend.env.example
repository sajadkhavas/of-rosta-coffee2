APP_NAME=Rosta
APP_ENV=staging
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://api.staging.rosta.shop
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

FRONTEND_ALLOWED_ORIGINS=https://staging.rosta.shop

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rosta_staging
DB_USERNAME=rosta_staging
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.staging.rosta.shop
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=rosta_staging_session
SANCTUM_STATEFUL_DOMAINS=staging.rosta.shop

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@staging.rosta.shop
MAIL_FROM_NAME=Rosta

ROSTA_PAYMENT_ENABLED=false
ROSTA_REFUND_ENABLED=false
ROSTA_SMS_ENABLED=false
ROSTA_OTP_ENABLED=false

PAYMENT_DRIVER=disabled
REFUND_DRIVER=disabled
SMS_DRIVER=disabled
ORDER_SMS_PROVIDER=disabled

ROSTA_MEDIA_UPLOADS_ENABLED=true
ROSTA_MEDIA_UPLOAD_DISK=s3
ROSTA_MEDIA_PUBLIC_BASE_URL=https://media.staging.rosta.shop
ROSTA_MEDIA_MAX_SIZE_BYTES=12000000
ROSTA_MEDIA_MAX_PIXELS=40000000
ROSTA_MEDIA_MAX_WIDTH=8000
ROSTA_MEDIA_MAX_HEIGHT=8000
ROSTA_MEDIA_MEMORY_LIMIT_MB=128
ROSTA_MEDIA_PROCESSING_TIMEOUT_MS=15000
ROSTA_MEDIA_MAX_PROCESSING_ATTEMPTS=3
ROSTA_MEDIA_ORPHAN_RETENTION_HOURS=24
ROSTA_MEDIA_VARIANT_VERSION=v1
ROSTA_MEDIA_VARIANT_WIDTHS=320,640,1280
ROSTA_MEDIA_UPLOAD_TTL_MINUTES=15

FILESYSTEM_DISK=local
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_DEFAULT_REGION=auto
S3_BUCKET=CHANGE_ME
S3_ENDPOINT=CHANGE_ME
S3_PUBLIC_URL=https://media.staging.rosta.shop
S3_USE_PATH_STYLE_ENDPOINT=false

ROSTA_ALLOWED_PAYMENT_REDIRECT_HOSTS=staging.rosta.shop
ROSTA_ALLOWED_MEDIA_HOSTS=media.staging.rosta.shop

# Keep real providers disabled through R4B acceptance.
PAYMENT_MERCHANT_ID=
KAVENEGAR_API_KEY=
KAVENEGAR_ORDER_SENDER=

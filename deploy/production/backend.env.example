APP_NAME=Rosta
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://api.rosta.shop
FRONTEND_ALLOWED_ORIGINS=https://rosta.shop

APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rosta
DB_USERNAME=rosta
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=rosta_session
SESSION_PATH=/
SESSION_DOMAIN=.rosta.shop
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=rosta.shop

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=rosta_prod_

ROSTA_OBSERVABILITY_LOG_CHANNEL=stack
ROSTA_OBSERVABILITY_QUEUES=critical,media,default,notifications
ROSTA_MAX_FAILED_JOBS=10
ROSTA_MAX_FAILED_JOB_AGE_SECONDS=900
ROSTA_MAX_QUEUE_DEPTH=1000

ROSTA_API_VERSION=v1
ROSTA_CONTRACT_VERSION=2026-07-26-r5c
ROSTA_DISPUTE_WINDOW_HOURS=72
ROSTA_CARRIER_WEBHOOK_SECRET=CHANGE_ME

# External rails remain fail-closed until SRV provider activation proves credentials/approval.
ROSTA_PAYMENT_ENABLED=false
PAYMENT_DRIVER=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://rosta.shop/checkout
PAYMENT_AMOUNT_MULTIPLIER=1
PAYMENT_ATTEMPT_TTL_MINUTES=20
PAYMENT_TIMEOUT_SECONDS=10
ZARINPAL_SANDBOX=false
ZARINPAL_REQUEST_URL=https://payment.zarinpal.com/pg/v4/payment/request.json
ZARINPAL_VERIFY_URL=https://payment.zarinpal.com/pg/v4/payment/verify.json
ZARINPAL_START_PAY_URL=https://www.zarinpal.com/pg/StartPay

ROSTA_REFUND_ENABLED=false
ROSTA_REFUND_DUAL_CONTROL=true
REFUND_DRIVER=disabled

ROSTA_SMS_ENABLED=false
ROSTA_OTP_ENABLED=false
SMS_DRIVER=disabled
ORDER_SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=

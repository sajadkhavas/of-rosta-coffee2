KAVENEGAR_CIRCUIT_OPEN_SECONDS=120
KAVENEGAR_OTP_TEMPLATE_LOGIN=
KAVENEGAR_OTP_TEMPLATE_REGISTER=
KAVENEGAR_OTP_TEMPLATE_VERIFY_MOBILE=

ROSTA_MEDIA_UPLOADS_ENABLED=false
FILESYSTEM_DISK=local

# Public production build/runtime contract. Copy to a protected host path; never commit real secrets.
VITE_SITE_URL=https://rosta.shop
VITE_API_URL=https://api.rosta.shop/api/v1
VITE_PAYMENT_REDIRECT_HOSTS=rosta.shop,api.rosta.shop,zarinpal.com,www.zarinpal.com
VITE_ALLOW_INDEXING=true
VITE_PERFORMANCE_ENDPOINT=

# Immutable release identity. Must be the exact 40-character Git commit SHA.
COMPOSE_PROJECT_NAME=rosta-production
ROSTA_IMAGE_TAG=0000000000000000000000000000000000000000
ROSTA_BACKEND_ENV_FILE=/etc/rosta/production/backend.env

# Public edge domains.
PRODUCTION_SITE_DOMAIN=rosta.shop
PRODUCTION_API_DOMAIN=api.rosta.shop
PRODUCTION_MEDIA_DOMAIN=media.rosta.shop
ACME_EMAIL=CHANGE_ME

# Host-side retention and acceptance behavior.
ROSTA_BACKUP_RETENTION_DAYS=30
ROSTA_ACCEPTANCE_TIMEOUT_SECONDS=240
ROSTA_STATE_DIR=/var/lib/rosta/production
ROSTA_BACKUP_DIR=/var/lib/rosta/production/backups

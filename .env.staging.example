# Public TanStack Start staging contract. Copy to .env.staging on the host.
VITE_SITE_URL=https://staging.rosta.shop
VITE_API_URL=https://api.staging.rosta.shop/api/v1
VITE_PAYMENT_REDIRECT_HOSTS=staging.rosta.shop,api.staging.rosta.shop,sandbox.zarinpal.com
VITE_ALLOW_INDEXING=false
VITE_PERFORMANCE_ENDPOINT=

# Docker Compose release identity.
COMPOSE_PROJECT_NAME=rosta-staging
ROSTA_IMAGE_TAG=staging-bootstrap
ROSTA_BACKEND_ENV_FILE=../../backend/.env.staging

# TLS edge and public domains. All stateful staging hosts remain under the
# staging-only cookie namespace; production rosta.shop/api.rosta.shop are outside it.
STAGING_SITE_DOMAIN=staging.rosta.shop
STAGING_API_DOMAIN=api.staging.rosta.shop
STAGING_MEDIA_DOMAIN=media.staging.rosta.shop
ACME_EMAIL=admin@rosta.shop

# Host-side retention and acceptance behavior.
ROSTA_BACKUP_RETENTION_DAYS=14
ROSTA_ACCEPTANCE_TIMEOUT_SECONDS=180

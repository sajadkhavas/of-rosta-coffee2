# syntax=docker/dockerfile:1.7

FROM oven/bun:1.2.22-alpine AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM dependencies AS build
ARG VITE_SITE_URL
ARG VITE_API_URL
ARG VITE_PAYMENT_REDIRECT_HOSTS
ARG VITE_ALLOW_INDEXING=false
ARG VITE_PERFORMANCE_ENDPOINT=
ENV NODE_ENV=production \
    NITRO_PRESET=node-server \
    VITE_SITE_URL=${VITE_SITE_URL} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_PAYMENT_REDIRECT_HOSTS=${VITE_PAYMENT_REDIRECT_HOSTS} \
    VITE_ALLOW_INDEXING=${VITE_ALLOW_INDEXING} \
    VITE_PERFORMANCE_ENDPOINT=${VITE_PERFORMANCE_ENDPOINT}
COPY . .
# `bun run check` includes bun run audit:phase22, bun run typecheck,
# unit tests, lint, bun run build and the bundle budget gate.
RUN bun run check

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/.output ./.output
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/robots.txt').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", ".output/server/index.mjs"]
